# Kopiraj u .env ako želiš mijenjati podrazumijevane vrijednosti.
PORT=4000
HOST=0.0.0.0

# Basic auth za /admin i /api/*
ADMIN_USER=admin
ADMIN_PASS=videowall

# Dijeljeni token koji panel šalje u heartbeatu (x-panel-token)
PANEL_TOKEN=panel-dev-token

# Gdje živi SQLite baza i media (podrazumijevano ./data).
# U Dockeru je ovo /data i pokriveno je volumenom — ne diraj.
# DATA_DIR=/var/lib/videowall

# Najveći dozvoljeni video u megabajtima (podrazumijevano 200).
# Ako ovo mijenjaš, uskladi i client_max_body_size u nginxu.
# MAX_VIDEO_MB=200

# info (podrazumijevano) piše red po zahtjevu; warn ostavlja samo probleme.
# LOG_LEVEL=warn
