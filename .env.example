# Kopiraj u .env ako želiš mijenjati podrazumijevane vrijednosti.
PORT=4000
HOST=0.0.0.0

# Basic auth za /admin i /api/*
ADMIN_USER=admin
ADMIN_PASS=videowall

# Dijeljeni token koji panel šalje u heartbeatu (x-panel-token)
PANEL_TOKEN=panel-dev-token

# Gdje živi SQLite baza i media (podrazumijevano ./data)
# DATA_DIR=/var/lib/videowall
