{
  "name": "video-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npm --prefix admin install && npm run build",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm --prefix admin run build",
    "seed": "node scripts/seed.js",
    "reset": "node scripts/reset.js"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "sharp": "^0.34.4"
  }
}
